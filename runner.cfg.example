# SSH Runner configuration — plain text, not executable Bash.
# Copy this file to runner.cfg and set chmod 600 runner.cfg.
# One [global] section, then one [node:N] section per server.
# Paths must be absolute or start with ~/ (expanded to the runner user's home).
# Do not use shell variables, quotes, commands or inline comments in values.
# This example uses reserved documentation IP addresses and hostnames.

[global]
ssh_user = deploy
ssh_key_path = ~/.ssh/id_ed25519
log_dir = ~/.local/state/runner
become = false

[node:1]
ip = 192.0.2.10
hostname = node1.example.com
role = Application server
become = true

[node:2]
ip = 198.51.100.20
hostname = node2.example.com
role = Database server
become = false

[node:3]
ip = 203.0.113.30
hostname = node3.example.com
ssh_user = admin
ssh_key_path = ~/.ssh/id_ed25519_admin
role = Administration server
# become inherits the global default when omitted
